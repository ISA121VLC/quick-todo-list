{
    "name": "local/gestor-tareas",
    "description": "Gestor de tareas web sencillo en PHP con SQLite",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "ext-session": "*"
    },
    "require-dev": {
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-xmlwriter": "*",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
